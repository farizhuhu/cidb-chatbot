# Environment for the Docker Compose / Dokploy deployment.
# In Dokploy these go in the Compose service's "Environment" tab, not in a file.
# Values marked REQUIRED have no default and the stack refuses to start without them.

# --- Application ---------------------------------------------------------
APP_NAME=CIDB Chatbot
APP_ENV=production
APP_DEBUG=false
# REQUIRED — public URL Dokploy serves this stack on
APP_URL=https://chatbot.example.com
APP_DISABLE_HASHING=false
# REQUIRED — long random secret used to encrypt sensitive fields at rest.
# Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# Extra browser origins allowed to call the API (comma separated). Leave empty
# when the widget is served from APP_URL itself; set it when embedding the
# widget on other sites.
CORS_ALLOWED_ORIGINS=

# --- Database ------------------------------------------------------------
# DB_HOST/DB_PORT are fixed to the bundled `db` service by docker-compose.yml.
DB_DATABASE=cidb_chatbot
DB_USERNAME=cidb_user
# REQUIRED
DB_PASSWORD=
DB_TIMEOUT=5

# Run pending migrations on container start.
RUN_MIGRATIONS=true

# --- Uploads -------------------------------------------------------------
UPLOAD_STORAGE_DRIVER=local
UPLOAD_MAX_FILE_SIZE_MB=10
SIGNATURE_MAX_FILE_SIZE_MB=5

# --- CIMS ----------------------------------------------------------------
CIMS_ENABLED=false
CIMS_BASE_URL=https://example.invalid
CIMS_VERIFY_ENDPOINT=/api/v1/verify
CIMS_TIMEOUT_MS=15000
CIMS_MOCK_MODE=random
CIMS_MOCK_OUTCOME=deleted
CIMS_API_KEY=
CIMS_CLIENT_ID=
CIMS_CLIENT_SECRET=

# --- RPA bot -------------------------------------------------------------
RPA_BOT_ENDPOINT=
RPA_BOT_API_KEY=
RPA_BOT_TIMEOUT_MS=15000
RPA_BOT_CONNECT_TIMEOUT_MS=5000
RPA_COMPANY_BOT_ENDPOINT=

# --- OCR service ---------------------------------------------------------
# OCR_SERVICE_BASE_URL is fixed to http://ocr:8001 by docker-compose.yml.
OCR_SERVICE_VERIFY_ENDPOINT=/api/verify-document
OCR_SERVICE_TIMEOUT_MS=45000
OCR_SERVICE_CONNECT_TIMEOUT_MS=5000
OCR_SERVICE_RETRY_COUNT=1
OCR_SERVICE_API_KEY=

# Thresholds applied inside the OCR container
OCR_MAX_FILE_SIZE_MB=8
OCR_MIN_CONFIDENCE=0.55
OCR_MIN_NAME_SIMILARITY=75
OCR_MANUAL_REVIEW_NAME_SCORE=60
